# Configuração do projeto Lead Score: o único lugar a editar para replicar em outro catálogo ou host.
# Lido por preflight.sh, reset_demo.sh e sql.py. Uma variável já definida no ambiente tem prioridade.
# Formato: CHAVE=valor (sem aspas, sem espaços em volta do =).

# Catálogo = nome do bundle = prefixo do pipeline (<catálogo>_pipeline) e do job (<catálogo>_setup)
LS_CATALOG=lh_ensaio05

# Profile do ~/.databrickscfg apontando para o host do workspace
LS_PROFILE=lead_score

# SQL Warehouse do workspace (databricks warehouses list --profile <profile>)
LS_WAREHOUSE=a50e6a998ebe9440

# App AppKit (reusado se já existir; o pre-flight cria se faltar e houver vaga)
LS_APP=lead-score-app

# Só para metastore SEM Default Storage: ex. s3://bucket/lead_score (exige external location)
LS_MANAGED_LOCATION=
